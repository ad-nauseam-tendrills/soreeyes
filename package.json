{
  "name": "sore-eyes",
  "version": "1.0.0",
  "private": true,
  "description": "Private deliberate-practice companion for An Accurate Eye and A Comparative Eye.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "extract-assets": "node scripts/extract-assets.mjs",
    "manifest": "UPDATE_MANIFEST=1 vitest run tests/manifest.test.ts",
    "audit:roles": "UPDATE_AUDIT=1 vitest run tests/audit-asset-roles.test.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "next": "^15.5.27",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
