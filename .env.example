# Copy to .env.local (dev) or /etc/soreeyes.env (server). Never commit real values.

# scrypt hash of the owner password: `npm run hash-password`
OWNER_PASSWORD_HASH=
# Random 32+ byte secret used to sign the session cookie: `openssl rand -base64 48`
SESSION_SECRET=

# Where progress (state.json, backups, photos) is stored. Must be writable.
DATA_DIR=./data
# Where extracted exercise pages live (output of `npm run extract-assets`). Never public.
ASSETS_DIR=./private-assets

# IANA time zone used for "today", streaks and review due dates.
APP_TIMEZONE=America/Los_Angeles
