# /etc/systemd/system/soreeyes.service
[Unit]
Description=Sore Eyes (private study companion)
After=network.target

[Service]
Type=simple
User=soreeyes
Group=soreeyes
WorkingDirectory=/opt/soreeyes/current
EnvironmentFile=/etc/soreeyes.env
Environment=NODE_ENV=production
Environment=PORT=3100
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3

# Hardening: the app may only write its data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/soreeyes/data

[Install]
WantedBy=multi-user.target
